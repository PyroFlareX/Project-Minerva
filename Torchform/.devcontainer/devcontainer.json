{
  "name": "Torchform Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "mounts": [
    // Persist cargo registry cache between container rebuilds
    "source=torchform-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=torchform-cargo-git,target=/usr/local/cargo/git,type=volume"
  ],
  // Forward the host display so Slint windows appear on your desktop.
  // X11 socket + Wayland socket are both forwarded — whichever the host uses.
  "runArgs": [
    "--network=host",
    "--env=DISPLAY=${localEnv:DISPLAY}",
    "--env=WAYLAND_DISPLAY=${localEnv:WAYLAND_DISPLAY}",
    "--env=XDG_RUNTIME_DIR=/tmp/runtime-dev",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw",
    "--volume=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY}:/tmp/runtime-dev/${localEnv:WAYLAND_DISPLAY}:rw"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "serayuzgur.crates",
        "ms-vscode.makefile-tools",
        "slint.slint"
      ],
      "settings": {
        // Use host toolchain (x86_64 native) for the shell/UI work
        "rust-analyzer.cargo.target": null,
        "rust-analyzer.checkOnSave.extraArgs": [],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "echo 'Torchform dev container ready. Run: make run-shell'",
  "remoteUser": "dev"
}
