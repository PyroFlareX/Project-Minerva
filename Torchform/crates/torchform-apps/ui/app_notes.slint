// =============================================================================
// app_notes.slint — Torchform Notes
// =============================================================================

import { Tokens } from "../../torchform-shell/ui/tokens.slint";

export struct NoteEntry {
    index:   int,
    title:   string,
    preview: string,
    time:    string,
}

component NoteRow inherits Rectangle {
    in property <NoteEntry> note;
    in property <bool>      focused;
    callback activated();

    height: 56px;
    background: focused ? Tokens.bg-elevated : transparent;
    animate background { duration: Tokens.anim-fast; }

    if focused: Rectangle { x: 0; width: 2px; height: parent.height; background: Tokens.accent; }

    VerticalLayout {
        padding-left: 14px; padding-right: 14px; padding-top: 8px; padding-bottom: 8px; spacing: 4px;
        HorizontalLayout {
            Text { horizontal-stretch: 1; text: note.title; font-size: Tokens.text-md; font-family: Tokens.font-sans; font-weight: Tokens.weight-semibold; color: Tokens.text-primary; overflow: elide; }
            Text { text: note.time; font-size: Tokens.text-xs; font-family: Tokens.font-mono; color: Tokens.text-disabled; vertical-alignment: center; }
        }
        Text { text: note.preview; font-size: Tokens.text-sm; font-family: Tokens.font-sans; color: Tokens.text-secondary; overflow: elide; }
    }

    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Tokens.border-subtle; }
    TouchArea { clicked => { root.activated(); } }
}

export component AppNotes inherits Rectangle {
    in property <int>         focused-row:  0;
    in property <[NoteEntry]> notes;
    in property <bool>        editing:      false;
    in property <string>      edit-title:   "";
    in property <string>      edit-body:    "";

    callback close-requested();
    callback open-note(int);
    callback new-note();
    callback save-note(string, string);
    callback delete-note(int);
    callback back-to-list();

    background: Tokens.bg-base;

    VerticalLayout {
        padding: 0px;

        Rectangle {
            height: 52px; background: Tokens.bg-surface;
            HorizontalLayout {
                padding-left: Tokens.space-4; padding-right: Tokens.space-4; alignment: center;
                if editing: Rectangle {
                    width: 32px; height: 32px; border-radius: 8px; background: Tokens.bg-elevated;
                    Text { width: parent.width; height: parent.height; text: "‹"; font-size: Tokens.text-lg; color: Tokens.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.back-to-list(); } }
                }
                if editing: Rectangle { width: Tokens.space-2; }
                Text {
                    horizontal-stretch: 1;
                    text: editing ? (edit-title != "" ? edit-title : "New Note") : "📝  Notes";
                    font-size: Tokens.text-xl; font-family: Tokens.font-sans; font-weight: Tokens.weight-semibold; color: Tokens.text-primary; vertical-alignment: center; overflow: elide;
                }
                if !editing: Rectangle {
                    width: 32px; height: 32px; border-radius: 8px; background: Tokens.accent.with-alpha(0.15);
                    border-width: 1px; border-color: Tokens.accent;
                    Text { width: parent.width; height: parent.height; text: "+"; font-size: 20px; color: Tokens.accent; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.new-note(); } }
                }
                if editing: Rectangle {
                    width: 48px; height: 28px; border-radius: Tokens.radius-sm; background: Tokens.accent;
                    Text { width: parent.width; height: parent.height; text: "Save"; font-size: Tokens.text-xs; font-family: Tokens.font-sans; color: Tokens.text-on-accent; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.save-note(edit-title, edit-body); } }
                }
                Rectangle { width: Tokens.space-2; }
                Rectangle {
                    width: 32px; height: 32px; border-radius: 16px; background: Tokens.bg-elevated;
                    Text { width: parent.width; height: parent.height; text: "✕"; font-size: Tokens.text-sm; color: Tokens.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.close-requested(); } }
                }
            }
        }

        if !editing: Rectangle {
            horizontal-stretch: 1; vertical-stretch: 1; clip: true;
            VerticalLayout {
                alignment: start;
                for n in notes: NoteRow {
                    note: n; focused: n.index == focused-row;
                    activated => { root.open-note(n.index); }
                }
                if notes.length == 0: Rectangle {
                    height: 100px;
                    VerticalLayout {
                        alignment: center; spacing: Tokens.space-2;
                        Text { text: "📝"; font-size: 32px; horizontal-alignment: center; }
                        Text { text: "No notes yet — press A to create one"; font-size: Tokens.text-sm; font-family: Tokens.font-sans; color: Tokens.text-disabled; horizontal-alignment: center; }
                    }
                }
            }
        }

        if editing: Rectangle {
            horizontal-stretch: 1; vertical-stretch: 1; background: Tokens.bg-base; clip: true;
            VerticalLayout {
                padding: 16px; spacing: 12px;

                Rectangle {
                    height: 40px; border-radius: Tokens.radius-md; background: Tokens.bg-elevated;
                    border-width: focused-row == 0 ? 1px : 0px; border-color: Tokens.accent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; alignment: center;
                        Text {
                            horizontal-stretch: 1;
                            text: edit-title != "" ? edit-title : "Title…";
                            font-size: Tokens.text-md; font-family: Tokens.font-sans;
                            color: edit-title != "" ? Tokens.text-primary : Tokens.text-disabled;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1; border-radius: Tokens.radius-md; background: Tokens.bg-elevated;
                    border-width: focused-row == 1 ? 1px : 0px; border-color: Tokens.accent;
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            vertical-stretch: 1;
                            text: edit-body != "" ? edit-body : "Start writing…";
                            font-size: Tokens.text-sm; font-family: Tokens.font-sans;
                            color: edit-body != "" ? Tokens.text-primary : Tokens.text-disabled;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 24px; background: Tokens.bg-surface;
            Text {
                width: parent.width; height: parent.height;
                text: editing ? "  ↑↓=Field  A=Confirm  X=Save  B=Cancel" : "  ↑↓=Select  A=Open  X=New  B=Close";
                font-size: Tokens.text-xs; font-family: Tokens.font-mono; color: Tokens.text-disabled; vertical-alignment: center;
            }
        }
    }
}
