// =============================================================================
// app_network_manager.slint — Torchform Network Manager
// =============================================================================

import { Tokens } from "../../torchform-shell/ui/tokens.slint";

export struct WifiNetwork {
    ssid:      string,
    signal:    int,
    secured:   bool,
    connected: bool,
}

export struct BtDevice {
    name:      string,
    paired:    bool,
    connected: bool,
}

component SectionHeader inherits Text {
    in property <string> label;
    text: label;
    font-size: Tokens.text-xs; font-family: Tokens.font-sans;
    font-weight: Tokens.weight-semibold; color: Tokens.text-secondary;
    height: 28px; vertical-alignment: center;
}

component NetworkRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> value: "";
    in property <bool>   focused: false;
    in property <bool>   active: false;
    callback activated();

    height: 52px; border-radius: Tokens.radius-md;
    background: focused ? Tokens.bg-elevated : transparent;
    border-width: focused ? 1px : 0px; border-color: Tokens.border-focused;
    animate background { duration: Tokens.anim-fast; }

    HorizontalLayout {
        padding-left: Tokens.space-4; padding-right: Tokens.space-4; spacing: Tokens.space-3; alignment: center;
        Text { text: icon; font-size: Tokens.text-lg; vertical-alignment: center; width: 28px; }
        Text { horizontal-stretch: 1; text: label; font-size: Tokens.text-md; font-family: Tokens.font-sans; color: Tokens.text-primary; vertical-alignment: center; }
        Text { text: value; font-size: Tokens.text-sm; font-family: Tokens.font-mono; color: active ? Tokens.success : Tokens.text-secondary; vertical-alignment: center; }
        Text { text: "›"; font-size: Tokens.text-lg; color: Tokens.text-disabled; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.activated(); } }
}

export component AppNetworkManager inherits Rectangle {
    in property <int>           focused-row: 0;
    in property <[WifiNetwork]> networks: [
        { ssid: "TorchNet-5G", signal: 85, secured: true,  connected: true  },
        { ssid: "HomeNetwork", signal: 60, secured: true,  connected: false },
        { ssid: "Guest_WiFi",  signal: 40, secured: false, connected: false },
    ];
    in property <bool> wifi-enabled:     true;
    in property <bool> bt-enabled:       false;
    in property <bool> cellular-enabled: false;
    in property <bool> vpn-active:       false;

    callback close-requested();
    callback connect-wifi(string);
    callback toggle-wifi();
    callback toggle-bt();
    callback toggle-cellular();
    callback toggle-vpn();

    background: Tokens.bg-base;

    VerticalLayout {
        padding: 0px;

        Rectangle {
            height: 52px; background: Tokens.bg-surface;
            HorizontalLayout {
                padding-left: Tokens.space-4; padding-right: Tokens.space-4; alignment: center;
                Text { horizontal-stretch: 1; text: "📡  Network"; font-size: Tokens.text-xl; font-family: Tokens.font-sans; font-weight: Tokens.weight-semibold; color: Tokens.text-primary; vertical-alignment: center; }
                Rectangle {
                    width: 32px; height: 32px; border-radius: 16px; background: Tokens.bg-elevated;
                    Text { width: parent.width; height: parent.height; text: "✕"; font-size: Tokens.text-sm; color: Tokens.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.close-requested(); } }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1; vertical-stretch: 1; background: Tokens.bg-base; clip: true;
            VerticalLayout {
                padding: Tokens.space-4; spacing: Tokens.space-1;
                SectionHeader { label: "WIRELESS"; }
                NetworkRow { icon: "📶"; label: "Wi-Fi";     value: wifi-enabled     ? "On" : "Off"; active: wifi-enabled;     focused: focused-row == 0; activated => { root.toggle-wifi(); } }
                NetworkRow { icon: "⬡";  label: "Bluetooth"; value: bt-enabled       ? "On" : "Off"; active: bt-enabled;       focused: focused-row == 1; activated => { root.toggle-bt(); } }
                NetworkRow { icon: "📡"; label: "Cellular";  value: cellular-enabled ? "On" : "Off"; active: cellular-enabled; focused: focused-row == 2; activated => { root.toggle-cellular(); } }
                SectionHeader { label: "PRIVACY"; }
                NetworkRow { icon: "🔒"; label: "VPN"; value: vpn-active ? "Connected" : "Off"; active: vpn-active; focused: focused-row == 3; activated => { root.toggle-vpn(); } }
                SectionHeader { label: "WIFI NETWORKS"; }
                for net[i] in networks: NetworkRow {
                    icon: net.connected ? "✓" : (net.secured ? "🔐" : "📶");
                    label: net.ssid; value: net.signal + "%"; active: net.connected;
                    focused: focused-row == (4 + i);
                    activated => { root.connect-wifi(net.ssid); }
                }
            }
        }

        Rectangle {
            height: 28px; background: Tokens.bg-surface;
            Text { width: parent.width; height: parent.height; text: "  A=Toggle/Connect  ↑↓=Navigate  B=Close"; font-size: Tokens.text-xs; font-family: Tokens.font-mono; color: Tokens.text-disabled; vertical-alignment: center; }
        }
    }
}
