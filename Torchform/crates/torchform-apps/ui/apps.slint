// =============================================================================
// torchform-apps/ui/apps.slint — shared data-model re-export hub
// =============================================================================
//
// App components are embedded by importing their defining files directly from
// shell and standalone window roots. They inherit Rectangle rather than Window,
// so exporting them from this library would make Slint generate no Rust code
// and emit a warning. Keep only the value types that are useful across roots.

import { SettingsEntry } from "app_settings.slint";
import { FileEntry } from "app_files.slint";
import { WifiNetwork, BtDevice } from "app_network_manager.slint";
import { SmsThread, SmsMessage } from "app_sms.slint";
import { EmailMsg } from "app_email.slint";
import { PkgEntry } from "app_pkgman.slint";
import { NoteEntry } from "app_notes.slint";

export {
    SettingsEntry,
    FileEntry,
    WifiNetwork, BtDevice,
    SmsThread, SmsMessage,
    EmailMsg,
    PkgEntry,
    NoteEntry,
}
