// =============================================================================
// app_phone.slint — Torchform Phone / Dialer
// =============================================================================

import { Tokens } from "../../torchform-shell/ui/tokens.slint";

export component AppPhone inherits Rectangle {
    in property <int>    focused-row: 0;
    in property <string> dialed:      "";
    in property <bool>   in-call:     false;
    in property <string> call-status: "Ready";

    callback close-requested();
    callback dial-digit(string);
    callback backspace();
    callback call();
    callback hang-up();

    background: Tokens.bg-base;

    property <[string]> keypad-labels: ["1","2","3","4","5","6","7","8","9","*","0","#"];
    property <[string]> keypad-subs:   ["","ABC","DEF","GHI","JKL","MNO","PQRS","TUV","WXYZ","","+ ",""];

    VerticalLayout {
        padding: 0px;

        Rectangle {
            height: 52px; background: Tokens.bg-surface;
            HorizontalLayout {
                padding-left: Tokens.space-4; padding-right: Tokens.space-4; alignment: center;
                Text { horizontal-stretch: 1; text: "📞  Phone"; font-size: Tokens.text-xl; font-family: Tokens.font-sans; font-weight: Tokens.weight-semibold; color: Tokens.text-primary; vertical-alignment: center; }
                Rectangle {
                    width: 32px; height: 32px; border-radius: 16px; background: Tokens.bg-elevated;
                    Text { width: parent.width; height: parent.height; text: "✕"; font-size: Tokens.text-sm; color: Tokens.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.close-requested(); } }
                }
            }
        }

        Rectangle {
            height: 80px; background: Tokens.bg-surface;
            VerticalLayout {
                alignment: center; padding: Tokens.space-3; spacing: 4px;
                Text {
                    text: dialed != "" ? dialed : "Enter number";
                    font-size: dialed != "" ? 28px : 16px;
                    font-family: Tokens.font-mono; font-weight: Tokens.weight-bold;
                    color: dialed != "" ? Tokens.text-primary : Tokens.text-disabled;
                    horizontal-alignment: center;
                }
                Text { text: call-status; font-size: Tokens.text-xs; font-family: Tokens.font-mono; color: Tokens.text-secondary; horizontal-alignment: center; }
            }
        }

        Rectangle {
            horizontal-stretch: 1; vertical-stretch: 1; background: Tokens.bg-base;

            property <length> key-w: (self.width - 40px) / 3;
            property <length> key-h: 56px;
            property <length> gap:   8px;

            for lbl[i] in keypad-labels: Rectangle {
                x: 20px + mod(i, 3) * (parent.key-w + parent.gap);
                y: 12px + floor(i / 3) * (parent.key-h + parent.gap);
                width: parent.key-w; height: parent.key-h;
                border-radius: Tokens.radius-md;
                background: focused-row == i ? Tokens.bg-elevated : Tokens.bg-surface;
                border-width: focused-row == i ? 1px : 0px;
                border-color: Tokens.accent;
                animate background { duration: Tokens.anim-fast; }

                VerticalLayout {
                    alignment: center;
                    Text { text: lbl; font-size: 20px; font-family: Tokens.font-mono; font-weight: Tokens.weight-bold; color: Tokens.text-primary; horizontal-alignment: center; }
                    Text { text: keypad-subs[i]; font-size: 8px; font-family: Tokens.font-mono; color: Tokens.text-secondary; horizontal-alignment: center; }
                }
                TouchArea { clicked => { root.dial-digit(lbl); } }
            }
        }

        Rectangle {
            height: 72px; background: Tokens.bg-base;
            HorizontalLayout {
                alignment: center; spacing: 24px; padding: 8px;

                Rectangle {
                    width: 56px; height: 56px; border-radius: 28px; background: Tokens.bg-elevated;
                    Text { width: parent.width; height: parent.height; text: "⌫"; font-size: 20px; color: Tokens.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.backspace(); } }
                }
                Rectangle {
                    width: 72px; height: 56px; border-radius: 28px;
                    background: in-call ? Tokens.error : Tokens.success;
                    Text { width: parent.width; height: parent.height; text: in-call ? "⏹" : "📞"; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { if (in-call) { root.hang-up(); } else { root.call(); } } }
                }
            }
        }

        Rectangle {
            height: 24px; background: Tokens.bg-surface;
            Text { width: parent.width; height: parent.height; text: "  ↑↓←→=Keypad  A=Dial  B=Close"; font-size: Tokens.text-xs; font-family: Tokens.font-mono; color: Tokens.text-disabled; vertical-alignment: center; }
        }
    }
}
