// =============================================================================
// app_terminal.slint — Torchform Terminal
// =============================================================================

import { Tokens } from "../../torchform-shell/ui/tokens.slint";

export struct TermLine {
    text:   string,
    kind:   string,   // "input" | "output" | "error"
}

export component AppTerminal inherits Rectangle {
    in property <int>         focused-row: 0;
    in property <[TermLine]>  lines;
    in property <string>      prompt:      "$ ";
    in property <string>      input-text:  "";
    in property <string>      cwd:         "/home/user";

    callback close-requested();
    callback submit-command(string);
    callback input-changed(string);

    background: #0a0c0f;

    VerticalLayout {
        padding: 0px;

        Rectangle {
            height: 36px; background: #111318;
            HorizontalLayout {
                padding-left: Tokens.space-4; padding-right: Tokens.space-4; alignment: center;
                Text { text: "⬛"; font-size: 12px; color: #4a9; vertical-alignment: center; }
                Rectangle { width: Tokens.space-2; }
                Text { horizontal-stretch: 1; text: "terminal — " + cwd; font-size: 10px; font-family: Tokens.font-mono; color: #88aacc; vertical-alignment: center; overflow: elide; }
                Rectangle {
                    width: 24px; height: 24px; border-radius: 12px; background: #ffffff11;
                    Text { width: parent.width; height: parent.height; text: "✕"; font-size: 9px; color: #667; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.close-requested(); } }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1; vertical-stretch: 1; background: #0a0c0f; clip: true;
            VerticalLayout {
                alignment: end; padding: 8px; spacing: 1px;
                for line in lines: Text {
                    text: line.text;
                    font-size: 11px; font-family: Tokens.font-mono;
                    color: line.kind == "error" ? #ff5555 : (line.kind == "input" ? #55ff55 : #cccccc);
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            height: 32px; background: #0d0f12;
            border-width: 1px; border-color: #1a2030;
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; alignment: center;
                Text { text: prompt; font-size: 11px; font-family: Tokens.font-mono; color: #55ff55; vertical-alignment: center; }
                Text {
                    horizontal-stretch: 1;
                    text: input-text != "" ? input-text : "type a command…";
                    font-size: 11px; font-family: Tokens.font-mono;
                    color: input-text != "" ? #eeeeee : #334;
                    vertical-alignment: center; overflow: elide;
                }
                Text { text: "▌"; font-size: 11px; font-family: Tokens.font-mono; color: #55ff55aa; vertical-alignment: center; }
            }
        }
    }
}
