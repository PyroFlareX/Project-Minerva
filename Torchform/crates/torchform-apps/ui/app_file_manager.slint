// =============================================================================
// app_file_manager.slint — Torchform File Manager (breadcrumb + grid/list)
// =============================================================================

import { Tokens } from "../../torchform-shell/ui/tokens.slint";
import { FileEntry } from "app_files.slint";

component FileRow inherits Rectangle {
    in property <FileEntry> entry;
    in property <bool>      focused: false;
    callback activated();

    height: 48px; border-radius: Tokens.radius-md;
    background: focused ? Tokens.bg-elevated : transparent;
    border-width: focused ? 1px : 0px; border-color: Tokens.border-focused;
    animate background { duration: Tokens.anim-fast; }

    HorizontalLayout {
        padding-left: Tokens.space-4; padding-right: Tokens.space-4;
        spacing: Tokens.space-3; alignment: center;
        Text { text: entry.icon; font-size: Tokens.text-lg; color: entry.kind == "dir" ? Tokens.accent : Tokens.text-secondary; vertical-alignment: center; width: 28px; }
        Text { horizontal-stretch: 1; text: entry.name; font-size: Tokens.text-md; font-family: Tokens.font-sans; color: Tokens.text-primary; vertical-alignment: center; overflow: elide; }
        Text { text: entry.size; font-size: Tokens.text-xs; font-family: Tokens.font-mono; color: Tokens.text-disabled; vertical-alignment: center; }
        Text { text: entry.kind == "dir" ? "›" : ""; font-size: Tokens.text-lg; color: Tokens.text-disabled; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.activated(); } }
}

export component AppFileManager inherits Rectangle {
    in property <int>      focused-row:  0;
    in property <string>   current-path: "/home";
    in property <bool>     grid-mode:    false;
    in property <[string]> path-parts:   ["home"];

    callback close-requested();
    callback navigate-up();
    callback navigate-to(string);
    callback open-file(string);

    property <[FileEntry]> demo-entries: [
        { icon: "📁", name: "Documents",  kind: "dir",  size: "" },
        { icon: "📁", name: "Downloads",  kind: "dir",  size: "" },
        { icon: "📁", name: "Pictures",   kind: "dir",  size: "" },
        { icon: "📁", name: "Videos",     kind: "dir",  size: "" },
        { icon: "📁", name: "Music",      kind: "dir",  size: "" },
        { icon: "📄", name: "notes.txt",  kind: "file", size: "4 KB" },
        { icon: "🖼",  name: "photo.jpg",  kind: "file", size: "2.1 MB" },
        { icon: "📦", name: "backup.tar", kind: "file", size: "512 MB" },
    ];

    background: Tokens.bg-base;

    VerticalLayout {
        padding: 0px;

        Rectangle {
            height: 52px; background: Tokens.bg-surface;
            HorizontalLayout {
                padding-left: Tokens.space-4; padding-right: Tokens.space-4; alignment: center; spacing: Tokens.space-2;
                Text { horizontal-stretch: 1; text: "📁  " + current-path; font-size: Tokens.text-md; font-family: Tokens.font-sans; color: Tokens.text-primary; vertical-alignment: center; overflow: elide; }
                Rectangle {
                    width: 32px; height: 32px; border-radius: 8px; background: Tokens.bg-elevated;
                    Text { width: parent.width; height: parent.height; text: "‹"; font-size: Tokens.text-lg; color: Tokens.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.navigate-up(); } }
                }
                Rectangle {
                    width: 32px; height: 32px; border-radius: 16px; background: Tokens.bg-elevated;
                    Text { width: parent.width; height: parent.height; text: "✕"; font-size: Tokens.text-sm; color: Tokens.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.close-requested(); } }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1; vertical-stretch: 1; background: Tokens.bg-base; clip: true;
            VerticalLayout {
                padding: Tokens.space-2; spacing: 0px;
                for entry[i] in demo-entries: FileRow {
                    entry: entry; focused: focused-row == i;
                    activated => {
                        if (entry.kind == "dir") { root.navigate-to(entry.name); }
                        else { root.open-file(entry.name); }
                    }
                }
            }
        }

        Rectangle {
            height: 28px; background: Tokens.bg-surface;
            Text { width: parent.width; height: parent.height; text: "  A=Open  B=Back  ↑↓=Navigate"; font-size: Tokens.text-xs; font-family: Tokens.font-mono; color: Tokens.text-disabled; vertical-alignment: center; }
        }
    }
}
