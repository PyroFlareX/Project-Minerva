// =============================================================================
// app_media_player.slint — Torchform Media Player (stub)
//
// Transport controls + track info. GStreamer pipeline wired in a later milestone.
// =============================================================================

import { Tokens } from "tokens.slint";

export component AppMediaPlayer inherits Rectangle {
    in property <int>    focused-row:   0;
    in property <string> track-title:   "No track loaded";
    in property <string> track-artist:  "";
    in property <string> track-album:   "";
    in property <float>  position:      0.0;   // 0.0–1.0
    in property <string> time-current:  "0:00";
    in property <string> time-total:    "0:00";
    in property <bool>   is-playing:    false;

    callback close-requested();
    callback play-pause();
    callback prev();
    callback next();
    callback seek(float);

    background: Tokens.bg-base;

    VerticalLayout {
        padding: 0px;

        // Header
        Rectangle {
            height: 52px;
            background: Tokens.bg-surface;
            HorizontalLayout {
                padding-left: Tokens.space-4; padding-right: Tokens.space-4;
                alignment: center;
                Text {
                    horizontal-stretch: 1;
                    text: "🎵  Media Player";
                    font-size: Tokens.text-md; font-family: Tokens.font-sans;
                    color: Tokens.text-primary; vertical-alignment: center;
                }
                Rectangle {
                    width: 32px; height: 32px; border-radius: 16px;
                    background: Tokens.bg-elevated;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "✕"; font-size: Tokens.text-sm;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.close-requested(); } }
                }
            }
        }

        // Album art placeholder
        Rectangle {
            horizontal-stretch: 1;
            height: 160px;
            background: Tokens.bg-elevated;
            Text {
                width: parent.width; height: parent.height;
                text: "🎵";
                font-size: 64px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Track info
        Rectangle {
            height: 72px;
            background: Tokens.bg-surface;
            VerticalLayout {
                alignment: center;
                padding: Tokens.space-3;
                spacing: Tokens.space-1;
                Text {
                    text: track-title;
                    font-size: Tokens.text-lg; font-family: Tokens.font-sans;
                    font-weight: Tokens.weight-semibold;
                    color: Tokens.text-primary;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: track-artist != "" ? track-artist + " — " + track-album : "Unknown artist";
                    font-size: Tokens.text-sm; font-family: Tokens.font-sans;
                    color: Tokens.text-secondary;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Progress bar
        Rectangle {
            height: 32px;
            background: Tokens.bg-base;
            HorizontalLayout {
                padding-left: Tokens.space-4; padding-right: Tokens.space-4;
                spacing: Tokens.space-3;
                alignment: center;
                Text {
                    text: time-current;
                    font-size: Tokens.text-xs; font-family: Tokens.font-mono;
                    color: Tokens.text-secondary; vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 4px;
                    background: Tokens.bg-elevated;
                    border-radius: 2px;
                    Rectangle {
                        x: 0; y: 0;
                        width: parent.width * position;
                        height: parent.height;
                        background: Tokens.accent;
                        border-radius: 2px;
                    }
                }
                Text {
                    text: time-total;
                    font-size: Tokens.text-xs; font-family: Tokens.font-mono;
                    color: Tokens.text-secondary; vertical-alignment: center;
                }
            }
        }

        // Transport controls
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: Tokens.bg-base;

            HorizontalLayout {
                alignment: center;
                spacing: Tokens.space-5;
                padding: Tokens.space-4;

                // Prev
                Rectangle {
                    width: 48px; height: 48px; border-radius: 24px;
                    background: focused-row == 1 ? Tokens.bg-elevated : transparent;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "⏮"; font-size: Tokens.text-xl;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.prev(); } }
                }

                // Play/Pause
                Rectangle {
                    width: 64px; height: 64px; border-radius: 32px;
                    background: focused-row == 0 ? Tokens.accent : Tokens.bg-elevated;
                    Text {
                        width: parent.width; height: parent.height;
                        text: is-playing ? "⏸" : "▶";
                        font-size: Tokens.text-xl;
                        color: focused-row == 0 ? Tokens.text-on-accent : Tokens.text-primary;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.play-pause(); } }
                }

                // Next
                Rectangle {
                    width: 48px; height: 48px; border-radius: 24px;
                    background: focused-row == 2 ? Tokens.bg-elevated : transparent;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "⏭"; font-size: Tokens.text-xl;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.next(); } }
                }
            }
        }

        // Status bar
        Rectangle {
            height: 24px;
            background: Tokens.bg-surface;
            Text {
                width: parent.width; height: parent.height;
                text: "  A=Play/Pause  ←/→=Prev/Next  B=Close";
                font-size: Tokens.text-xs; font-family: Tokens.font-mono;
                color: Tokens.text-disabled; vertical-alignment: center;
            }
        }
    }
}
