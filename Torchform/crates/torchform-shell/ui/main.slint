// main.slint — single compilation entry point
// Imports and re-exports all public types from all display and app slint files
// so that slint_build only needs one compile call and include_modules!() sees
// everything in one generated module.

import { Tokens } from "tokens.slint";
import { ShellOverlay, RadialItem, RadialLayer, CommandEntry, VoiceState, AppEntry }
    from "shell.slint";
import { LowerScreen, LowerContext, StatusPanel, VirtualKeyboard }
    from "lower_screen.slint";
import { TorchformEmulator }
    from "emulator.slint";
import { ShellScreen } from "chrome/shell_screen.slint";
import { HomeTile } from "chrome/home_screen.slint";
import { HintItem } from "chrome/hint_bar.slint";
import { QsTile } from "chrome/quick_settings.slint";
import { NotifEntry } from "chrome/notifications.slint";

export {
    // Design system global (exported so Rust can push theme values at startup)
    Tokens,

    // Shell overlay (standalone two-window mode)
    ShellOverlay,
    RadialItem, RadialLayer,
    CommandEntry, VoiceState,
    AppEntry,

    // Lower companion screen (standalone mode)
    LowerScreen,
    LowerContext,

    // Combined emulator window (default mode)
    TorchformEmulator,

    // N3DS shell chrome types (used by the Rust render layer)
    ShellScreen,
    HomeTile,
    HintItem,
    QsTile,
    NotifEntry,
}
