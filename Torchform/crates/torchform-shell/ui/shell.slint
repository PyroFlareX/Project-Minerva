// =============================================================================
// shell.slint — Torchform upper-display shell root
//
// The shell overlays above the application surface on the upper 1920×1080
// display. It hosts:
//   - The radial menu overlay  (L2 / R2 / L2+R2)
//   - The command palette      (Select)
//   - The app switcher         (Start)
//   - A minimal system status strip at the very top edge
//
// When no overlay is active the shell is completely transparent, letting the
// focused application fill the entire screen.
// =============================================================================

import { Tokens }          from "tokens.slint";
import { RadialMenu, RadialItem, RadialLayer } from "radial_menu.slint";
import { CommandPalette, CommandEntry, VoiceState } from "command_palette.slint";
import { AppSwitcher, AppEntry }                    from "app_switcher.slint";
import { ShellScreen } from "chrome/shell_screen.slint";
import { StatusBar } from "chrome/status_bar.slint";
import { HintBar, HintItem } from "chrome/hint_bar.slint";
import { LockScreen } from "chrome/lock_screen.slint";
import { HomeScreen, HomeTile } from "chrome/home_screen.slint";
import { AppTitleBar } from "chrome/app_window.slint";
import { QuickSettings, QsTile } from "chrome/quick_settings.slint";
import { Notifications, NotifEntry } from "chrome/notifications.slint";
import { Banner } from "chrome/banner.slint";
import { QuickMenu, QuickMenuItem } from "quick_menu.slint";
import { AppSettings, SettingsEntry, SidebarEntry } from "../../torchform-apps/ui/app_settings.slint";
import { AppFiles, FileEntry } from "../../torchform-apps/ui/app_files.slint";
import { AppFileManager }    from "../../torchform-apps/ui/app_file_manager.slint";
import { AppCamera }         from "../../torchform-apps/ui/app_camera.slint";
import { AppWebBrowser }     from "../../torchform-apps/ui/app_web_browser.slint";
import { AppMediaPlayer }    from "../../torchform-apps/ui/app_media_player.slint";
import { AppNetworkManager, WifiNetwork } from "../../torchform-apps/ui/app_network_manager.slint";
import { AppTerminal, TermLine } from "../../torchform-apps/ui/app_terminal.slint";
import { AppNotes, NoteEntry } from "../../torchform-apps/ui/app_notes.slint";
import { AppSysmon }           from "../../torchform-apps/ui/app_sysmon.slint";
import { AppLogview, LogLine } from "../../torchform-apps/ui/app_logview.slint";

export {
    RadialItem, RadialLayer,
    CommandEntry, VoiceState,
    AppEntry,
}

export component ShellOverlay inherits Window {

    // -----------------------------------------------------------------------
    // Radial menu
    // -----------------------------------------------------------------------
    in property <bool>           radial-visible: false;
    in property <[RadialItem]>   radial-items;
    in property <int>            radial-focused: 0;
    in property <RadialLayer>    radial-layer: RadialLayer.System;

    callback radial-item-activated(int);
    callback radial-dismissed();

    // -----------------------------------------------------------------------
    // Command palette
    // -----------------------------------------------------------------------
    in property <bool>            palette-visible: false;
    in property <[CommandEntry]>  palette-entries;
    in property <string>          palette-query: "";
    in property <int>             palette-focused: 0;
    in property <VoiceState>      palette-voice: VoiceState.Idle;

    callback palette-entry-activated(int);
    callback palette-dismissed();
    callback palette-query-changed(string);

    // -----------------------------------------------------------------------
    // App switcher
    // -----------------------------------------------------------------------
    in property <bool>         switcher-visible: false;
    in property <[AppEntry]>   switcher-apps;
    in property <int>          switcher-focused: 0;

    callback switcher-app-activated(int);
    callback switcher-app-closed(int);
    callback switcher-dismissed();

    // Embedded app panels
    in property <bool>                app-settings-visible: false;
    in property <int>                 app-settings-focused-row: 0;
    in property <[SettingsEntry]>     app-settings-entries;
    in property <[SidebarEntry]>      app-settings-sidebar-entries;
    in property <int>                 app-settings-sidebar-focus: 0;
    in property <bool>                app-settings-sidebar-in-focus: true;
    in property <string>              app-settings-section-title: "Settings";
    in property <bool>         app-files-visible: false;
    in property <int>          app-files-focused-row: 0;
    in property <string>       app-files-path: "/home";
    in property <[FileEntry]>  app-files-entries;
    in property <bool>   app-camera-visible: false;
    in property <int>    app-camera-focused-row: 0;
    in property <bool>   app-browser-visible: false;
    in property <int>    app-browser-focused-row: 0;
    in property <string> app-browser-url: "about:blank";
    in property <bool>   app-media-visible: false;
    in property <int>    app-media-focused-row: 0;
    in property <bool>           app-network-visible: false;
    in property <int>            app-network-focused-row: 0;
    in property <[WifiNetwork]>  app-network-wifi-list;
    in property <bool>           app-network-wifi-enabled: true;
    in property <bool>           app-network-bt-enabled: false;
    in property <bool>           app-network-cellular-enabled: false;
    in property <bool>           app-network-vpn-active: false;
    callback app-network-connect-wifi(string);
    callback app-network-toggle-wifi();
    callback app-network-toggle-bt();
    callback app-network-toggle-cellular();
    callback app-network-toggle-vpn();
    in property <bool>         app-keyboard-visible: false;
    in property <bool>         app-terminal-visible: false;
    in property <[TermLine]>   app-terminal-lines;
    in property <string>       app-terminal-input: "";
    in property <string>       app-terminal-cwd: "/home/user";

    in property <bool>           app-notes-visible: false;
    in property <int>            app-notes-focused-row: 0;
    in property <[NoteEntry]>    app-notes-list;
    in property <bool>           app-notes-editing: false;
    in property <string>         app-notes-edit-title: "";
    in property <string>         app-notes-edit-body: "";
    callback app-notes-new();
    callback app-notes-open(int);
    callback app-notes-save(string, string);
    callback app-notes-delete(int);
    callback app-notes-back();

    // Sysmon
    in property <bool>     app-sysmon-visible: false;
    in property <float>    app-sysmon-cpu-pct: 0.0;
    in property <float>    app-sysmon-ram-pct: 0.0;
    in property <float>    app-sysmon-gpu-pct: 0.0;
    in property <float>    app-sysmon-temp-c:  40.0;
    in property <int>      app-sysmon-ram-used-mb: 0;
    in property <int>      app-sysmon-ram-total-mb: 4096;
    in property <string>   app-sysmon-cpu-name: "Unknown CPU";
    in property <[float]>  app-sysmon-core-pcts;
    in property <[string]> app-sysmon-proc-names;
    in property <[float]>  app-sysmon-proc-cpus;
    in property <[int]>    app-sysmon-proc-mems;

    // Logview
    in property <bool>       app-logview-visible: false;
    in property <[LogLine]>  app-logview-lines;
    in property <bool>       app-logview-show-info:  true;
    in property <bool>       app-logview-show-warn:  true;
    in property <bool>       app-logview-show-error: true;
    in property <bool>       app-logview-show-debug: false;
    in property <bool>       app-logview-tail:       true;
    callback app-logview-toggle-level(string);
    callback app-logview-toggle-tail();
    callback app-logview-clear();

    callback app-closed();
    callback app-settings-section-selected(int);
    callback app-settings-setting-activated(string);
    callback app-settings-setting-adjusted(string, int);
    callback app-files-navigate(string);
    callback app-files-navigate-parent();

    // -----------------------------------------------------------------------
    // Status strip
    // -----------------------------------------------------------------------
    in property <string>  time-str: "00:00";
    in property <int>     battery-pct: 100;
    in property <bool>    charging: false;
    in property <bool>    wifi-connected: true;
    in property <int>     workspace-index: 0;

    // -----------------------------------------------------------------------
    // N3DS shell chrome (screen stack, status bar, hint bar, home, lock)
    // -----------------------------------------------------------------------
    in property <ShellScreen> screen: ShellScreen.Lock;
    in property <string>      date-str: "Monday, Jan 1";
    in property <int>         pin-len: 0;

    in property <string> sb-app-name:    "";
    in property <string> sb-now-playing: "";
    in property <bool>   sb-bt:          true;
    in property <bool>   sb-dnd:         false;
    in property <bool>   sb-airplane:    false;
    in property <int>    sb-notif-count: 0;

    in property <[HomeTile]> home-grid-tiles;
    in property <[HomeTile]> home-dock-tiles;
    in property <int>        home-focus: 0;
    callback home-tile-activated(int);

    in property <[HintItem]> hint-items;

    in property <string> app-icon: "";
    in property <string> app-name: "";
    callback app-home-pressed();
    callback app-switcher-pressed();

    // Quick Settings panel
    in property <bool>      qs-open: false;
    in property <int>       qs-vol: 70;
    in property <int>       qs-bright: 85;
    in property <[QsTile]>  qs-tiles;
    in property <int>       qs-focus: 0;
    callback qs-volume-changed(int);
    callback qs-brightness-changed(int);
    callback qs-tile-activated(int);

    // Notifications panel
    in property <bool>          nf-open: false;
    in property <[NotifEntry]>  nf-entries;
    in property <int>           nf-focus: 0;
    in property <string>        nf-count: "0 new";
    callback nf-activated(int);
    callback nf-clear-all();

    // Quick Menu overlay
    in property <bool>              qm-open: false;
    in property <int>               qm-focus: 0;
    in property <[QuickMenuItem]>   qm-items;
    callback qm-item-activated(string);
    callback qm-close-requested();

    // Banner toast
    in property <bool>   banner-open: false;
    in property <string> banner-icon: "";
    in property <string> banner-app: "";
    in property <string> banner-title: "";
    in property <string> banner-body: "";

    // -----------------------------------------------------------------------
    // Keyboard shortcut callbacks (desktop testing; mapped to controller grammar)
    //   Space   → Select (palette)    Enter → Start (switcher)
    //   Tab↓/↑  → L2 held/released    Esc   → B (back)
    //   A       → A (confirm)         ↑↓←→  → D-pad
    // -----------------------------------------------------------------------
    callback key-select();
    callback key-start();
    callback key-l2(bool);
    callback key-b();
    callback key-a();
    callback key-x();
    callback key-quick-settings();
    callback key-notifications();
    callback key-up();
    callback key-down();
    callback key-left();
    callback key-right();
    // Analog stick simulation for desktop testing — hold Tab + IJKL
    callback key-stick-n();
    callback key-stick-s();
    callback key-stick-e();
    callback key-stick-w();
    callback key-stick-release();

    // -----------------------------------------------------------------------
    // Root geometry — transparent, full upper screen
    // -----------------------------------------------------------------------
    width:      Tokens.upper-width;
    height:     Tokens.upper-height;
    background: transparent;

    // -----------------------------------------------------------------------
    // Screen content area (between status bar and hint bar)
    // -----------------------------------------------------------------------
    Rectangle {
        x: 0; y: 36px;
        width: parent.width;
        height: parent.height - 36px - 32px;
        clip: true;

        if root.screen == ShellScreen.Lock: LockScreen {
            width: parent.width; height: parent.height;
            time-str: root.time-str;
            date-str: root.date-str;
            pin-len:  root.pin-len;
        }

        if root.screen == ShellScreen.Home: HomeScreen {
            width: parent.width; height: parent.height;
            grid-tiles: root.home-grid-tiles;
            dock-tiles: root.home-dock-tiles;
            home-focus: root.home-focus;
            tile-activated(i) => { root.home-tile-activated(i); }
        }

        if root.screen == ShellScreen.App: Rectangle {
            width: parent.width; height: parent.height;

            AppTitleBar {
                x: 0; y: 0;
                width: parent.width;
                icon: root.app-icon;
                name: root.app-name;
                home-pressed     => { root.app-home-pressed(); }
                switcher-pressed => { root.app-switcher-pressed(); }
            }

            Rectangle {
                x: 0; y: 32px;
                width: parent.width;
                height: parent.height - 32px;
                clip: true;

                if app-settings-visible: AppSettings {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    focused-row:         app-settings-focused-row;
                    entries:             app-settings-entries;
                    sidebar-entries:     app-settings-sidebar-entries;
                    sidebar-focus:       app-settings-sidebar-focus;
                    sidebar-in-focus:    app-settings-sidebar-in-focus;
                    section-title:       app-settings-section-title;
                    close-requested          => { root.app-closed(); }
                    section-selected(i)      => { root.app-settings-section-selected(i); }
                    setting-activated(key)   => { root.app-settings-setting-activated(key); }
                    setting-adjusted(key, d) => { root.app-settings-setting-adjusted(key, d); }
                }
                if app-files-visible: AppFiles {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    current-path:  app-files-path;
                    focused-row:   app-files-focused-row;
                    entries:       app-files-entries;
                    close-requested => { root.app-closed(); }
                    navigate(name)  => { root.app-files-navigate(name); }
                    navigate-parent => { root.app-files-navigate-parent(); }
                }
                if app-camera-visible: AppCamera {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    focused-row: app-camera-focused-row;
                    close-requested => { root.app-closed(); }
                }
                if app-browser-visible: AppWebBrowser {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    focused-row: app-browser-focused-row;
                    url: app-browser-url;
                    close-requested => { root.app-closed(); }
                }
                if app-media-visible: AppMediaPlayer {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    focused-row: app-media-focused-row;
                    close-requested => { root.app-closed(); }
                }
                if app-network-visible: AppNetworkManager {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    focused-row:      app-network-focused-row;
                    networks:         app-network-wifi-list;
                    wifi-enabled:     app-network-wifi-enabled;
                    bt-enabled:       app-network-bt-enabled;
                    cellular-enabled: app-network-cellular-enabled;
                    vpn-active:       app-network-vpn-active;
                    close-requested   => { root.app-closed(); }
                    connect-wifi(s)   => { root.app-network-connect-wifi(s); }
                    toggle-wifi       => { root.app-network-toggle-wifi(); }
                    toggle-bt         => { root.app-network-toggle-bt(); }
                    toggle-cellular   => { root.app-network-toggle-cellular(); }
                    toggle-vpn        => { root.app-network-toggle-vpn(); }
                }
                if app-terminal-visible: AppTerminal {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    lines:      app-terminal-lines;
                    input-text: app-terminal-input;
                    cwd:        app-terminal-cwd;
                    close-requested => { root.app-closed(); }
                }
                if app-notes-visible: AppNotes {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    focused-row:  app-notes-focused-row;
                    notes:        app-notes-list;
                    editing:      app-notes-editing;
                    edit-title:   app-notes-edit-title;
                    edit-body:    app-notes-edit-body;
                    close-requested => { root.app-closed(); }
                    new-note        => { root.app-notes-new(); }
                    open-note(i)    => { root.app-notes-open(i); }
                    save-note(t, b) => { root.app-notes-save(t, b); }
                    delete-note(i)  => { root.app-notes-delete(i); }
                    back-to-list    => { root.app-notes-back(); }
                }
                if app-sysmon-visible: AppSysmon {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    cpu-pct:      app-sysmon-cpu-pct;
                    ram-pct:      app-sysmon-ram-pct;
                    gpu-pct:      app-sysmon-gpu-pct;
                    temp-c:       app-sysmon-temp-c;
                    ram-used-mb:  app-sysmon-ram-used-mb;
                    ram-total-mb: app-sysmon-ram-total-mb;
                    cpu-name:     app-sysmon-cpu-name;
                    core-pcts:    app-sysmon-core-pcts;
                    proc-names:   app-sysmon-proc-names;
                    proc-cpus:    app-sysmon-proc-cpus;
                    proc-mems:    app-sysmon-proc-mems;
                    close-requested => { root.app-closed(); }
                }
                if app-logview-visible: AppLogview {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    lines:       app-logview-lines;
                    show-info:   app-logview-show-info;
                    show-warn:   app-logview-show-warn;
                    show-error:  app-logview-show-error;
                    show-debug:  app-logview-show-debug;
                    tail-mode:   app-logview-tail;
                    close-requested => { root.app-closed(); }
                    toggle-level(l) => { root.app-logview-toggle-level(l); }
                    toggle-tail     => { root.app-logview-toggle-tail(); }
                    clear           => { root.app-logview-clear(); }
                }
                if app-keyboard-visible: Rectangle {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    background: Tokens.bg-base;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "⌨  On-Screen Keyboard active on lower display";
                        font-size: Tokens.text-sm;
                        color: Tokens.text-disabled;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Overlays (cover the content area, above the screen)
        AppSwitcher {
            visible:          switcher-visible;
            apps:             switcher-apps;
            focused-index:    switcher-focused;
            visible-prop:     switcher-visible;
            app-activated(i) => { root.switcher-app-activated(i); }
            app-closed(i)    => { root.switcher-app-closed(i); }
            dismissed        => { root.switcher-dismissed(); }
        }
        CommandPalette {
            visible:          palette-visible;
            entries:          palette-entries;
            query:            palette-query;
            focused-index:    palette-focused;
            voice-state:      palette-voice;
            visible-prop:     palette-visible;
            entry-activated(i)  => { root.palette-entry-activated(i); }
            dismissed           => { root.palette-dismissed(); }
            query-changed(q)    => { root.palette-query-changed(q); }
        }
        RadialMenu {
            visible:          radial-visible;
            items:            radial-items;
            focused-index:    radial-focused;
            layer:            radial-layer;
            visible-prop:     radial-visible;
            item-activated(i) => { root.radial-item-activated(i); }
            dismissed         => { root.radial-dismissed(); }
        }

        // Slide-in panels + banner
        QuickSettings {
            open:        root.qs-open;
            time-str:    root.time-str;
            vol:         root.qs-vol;
            bright:      root.qs-bright;
            tiles:       root.qs-tiles;
            focus-index: root.qs-focus;
            volume-changed(v)     => { root.qs-volume-changed(v); }
            brightness-changed(v) => { root.qs-brightness-changed(v); }
            tile-activated(i)     => { root.qs-tile-activated(i); }
        }
        Notifications {
            open:        root.nf-open;
            entries:     root.nf-entries;
            focus-index: root.nf-focus;
            count-label: root.nf-count;
            activated(i) => { root.nf-activated(i); }
            clear-all    => { root.nf-clear-all(); }
        }
        Banner {
            open:  root.banner-open;
            icon:  root.banner-icon;
            app:   root.banner-app;
            title: root.banner-title;
            body:  root.banner-body;
        }
        QuickMenu {
            open:        root.qm-open;
            focus-index: root.qm-focus;
            items:       root.qm-items;
            item-activated(key) => { root.qm-item-activated(key); }
            close-requested     => { root.qm-close-requested(); }
        }
    }

    // Status bar (top)
    StatusBar {
        x: 0; y: 0;
        width: parent.width;
        workspace-index: root.workspace-index;
        app-name:        root.sb-app-name;
        time-str:        root.time-str;
        now-playing:     root.sb-now-playing;
        wifi:            root.wifi-connected;
        bluetooth:       root.sb-bt;
        dnd:             root.sb-dnd;
        airplane:        root.sb-airplane;
        notif-count:     root.sb-notif-count;
        battery-pct:     root.battery-pct;
    }

    // Hint bar (bottom)
    HintBar {
        x: 0; y: parent.height - 32px;
        width: parent.width;
        items: root.hint-items;
    }

    // -----------------------------------------------------------------------
    // Global keyboard handler
    // -----------------------------------------------------------------------
    forward-focus: key-handler;

    key-handler := FocusScope {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if event.text == " "                             { root.key-select();   accept }
            else if event.text == Key.Return                 { root.key-start();    accept }
            else if event.text == Key.Tab                    { root.key-l2(true);  accept }
            else if event.text == Key.Escape                 { root.key-b();        accept }
            else if event.text == "a" || event.text == "A"  { root.key-a();        accept }
            else if event.text == "x" || event.text == "X"  { root.key-x();        accept }
            else if event.text == "z" || event.text == "Z"  { root.key-quick-settings();  accept }
            else if event.text == "c" || event.text == "C"  { root.key-notifications();   accept }
            else if event.text == Key.UpArrow                { root.key-up();       accept }
            else if event.text == Key.DownArrow              { root.key-down();     accept }
            else if event.text == Key.LeftArrow              { root.key-left();     accept }
            else if event.text == Key.RightArrow             { root.key-right();    accept }
            else if event.text == "i" || event.text == "I"  { root.key-stick-n();  accept }
            else if event.text == "k" || event.text == "K"  { root.key-stick-s();  accept }
            else if event.text == "j" || event.text == "J"  { root.key-stick-w();  accept }
            else if event.text == "l" || event.text == "L"  { root.key-stick-e();  accept }
            else { reject }
        }
        key-released(event) => {
            if event.text == Key.Tab { root.key-l2(false); accept }
            else if event.text == "i" || event.text == "I" ||
                    event.text == "k" || event.text == "K" ||
                    event.text == "j" || event.text == "J" ||
                    event.text == "l" || event.text == "L" { root.key-stick-release(); accept }
            else { reject }
        }
    }
}
