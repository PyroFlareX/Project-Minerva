// =============================================================================
// app_terminal.slint — Terminal emulator stub
//
// On real hardware, the external terminal binary (foot/alacritty) is launched
// via try_launch_external() and appears as a tiled Wayland client.
// This stub is shown in emulator mode when no external binary is configured.
// =============================================================================

import { Tokens } from "tokens.slint";

export component AppTerminal inherits Rectangle {
    in property <int> focused-row: 0;
    callback close-requested();

    background: #0a0c0f;

    VerticalLayout {
        padding: 0px;

        // Header
        Rectangle {
            height: 52px;
            background: Tokens.bg-surface;

            HorizontalLayout {
                padding-left:  Tokens.space-4;
                padding-right: Tokens.space-4;
                alignment: center;

                Text {
                    horizontal-stretch: 1;
                    text: "⬛  Terminal";
                    font-size: Tokens.text-xl;
                    font-family: Tokens.font-sans;
                    font-weight: Tokens.weight-semibold;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 32px; height: 32px;
                    border-radius: 16px;
                    background: Tokens.bg-elevated;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "✕";
                        font-size: Tokens.text-sm;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.close-requested(); } }
                }
            }
        }

        // Body — placeholder, real terminal is an external Wayland client
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch:   1;
            background: #0a0c0f;

            VerticalLayout {
                alignment: center;
                spacing: Tokens.space-3;

                Text {
                    text: "⬛";
                    font-size: 48px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    text: "Terminal";
                    font-size: Tokens.text-lg;
                    font-family: Tokens.font-sans;
                    color: Tokens.text-secondary;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Configure [apps] terminal = \"foot\" or \"alacritty\"\nin config.toml to launch on hardware.";
                    font-size: Tokens.text-xs;
                    font-family: Tokens.font-mono;
                    color: Tokens.text-disabled;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
