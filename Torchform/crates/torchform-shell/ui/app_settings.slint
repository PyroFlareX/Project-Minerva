// =============================================================================
// app_settings.slint — Torchform Settings app (stub)
//
// A basic settings screen. Each section is a placeholder row that will grow
// into real functionality as the DE matures.
// =============================================================================

import { Tokens } from "tokens.slint";

component SettingsRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> value: "";
    in property <bool>   focused: false;

    callback activated();

    height: 52px;
    border-radius: Tokens.radius-md;
    background: focused ? Tokens.bg-elevated : transparent;
    border-width: focused ? 1px : 0px;
    border-color: Tokens.border-focused;

    animate background { duration: Tokens.anim-fast; }

    HorizontalLayout {
        padding-left:  Tokens.space-4;
        padding-right: Tokens.space-4;
        spacing: Tokens.space-3;
        alignment: center;

        Text {
            text: icon;
            font-size: Tokens.text-lg;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: label;
            font-size: Tokens.text-md;
            font-family: Tokens.font-sans;
            color: Tokens.text-primary;
            vertical-alignment: center;
        }
        Text {
            text: value;
            font-size: Tokens.text-sm;
            font-family: Tokens.font-mono;
            color: Tokens.text-secondary;
            vertical-alignment: center;
        }
        Text {
            text: "›";
            font-size: Tokens.text-lg;
            color: Tokens.text-disabled;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.activated(); } }
}

component SectionHeader inherits Text {
    in property <string> label;
    text: label;
    font-size: Tokens.text-xs;
    font-family: Tokens.font-sans;
    font-weight: Tokens.weight-semibold;
    color: Tokens.text-secondary;
    height: 28px;
    vertical-alignment: center;
}

export component AppSettings inherits Rectangle {
    in property <int>    focused-row:       0;
    // Live values pushed by Rust backend (empty = show placeholder)
    in property <string> brightness-value:  "80%";
    in property <string> volume-value:      "65%";
    in property <string> wifi-value:        "Connected";
    in property <string> bt-value:          "On";
    in property <string> cellular-value:    "Off";
    in property <string> vpn-value:         "Off";
    in property <string> battery-value:     "87%";
    // Active sub-section ("" = show list, "display" | "audio" | etc. = sub-panel)
    in property <string> active-section:    "";

    callback close-requested();
    // Fired when user activates a row — passes the setting key
    callback setting-activated(string);

    background: Tokens.bg-base;

    VerticalLayout {
        padding: 0px;

        // Header
        Rectangle {
            height: 52px;
            background: Tokens.bg-surface;
            border-width: 0px;

            HorizontalLayout {
                padding-left:  Tokens.space-4;
                padding-right: Tokens.space-4;
                alignment: center;

                Text {
                    horizontal-stretch: 1;
                    text: active-section == "" ? "⚙  Settings" : ("⚙  Settings › " + active-section);
                    font-size: Tokens.text-xl;
                    font-family: Tokens.font-sans;
                    font-weight: Tokens.weight-semibold;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    width: 32px; height: 32px;
                    border-radius: 16px;
                    background: Tokens.bg-elevated;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "✕";
                        font-size: Tokens.text-sm;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.close-requested(); } }
                }
            }
        }

        // Content
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: Tokens.bg-base;
            clip: true;

            VerticalLayout {
                padding: Tokens.space-4;
                spacing: Tokens.space-1;

                SectionHeader { label: "DISPLAY"; }
                SettingsRow {
                    icon: "🔆"; label: "Brightness"; value: brightness-value;
                    focused: focused-row == 0;
                    activated => { root.setting-activated("display.brightness"); }
                }
                SettingsRow {
                    icon: "🌙"; label: "Night Mode"; value: "Off";
                    focused: focused-row == 1;
                    activated => { root.setting-activated("display.night_mode"); }
                }
                SettingsRow {
                    icon: "📐"; label: "Resolution"; value: "1920×1080";
                    focused: focused-row == 2;
                    activated => { root.setting-activated("display.resolution"); }
                }

                SectionHeader { label: "AUDIO"; }
                SettingsRow {
                    icon: "🔊"; label: "Volume"; value: volume-value;
                    focused: focused-row == 3;
                    activated => { root.setting-activated("audio.volume"); }
                }
                SettingsRow {
                    icon: "🎧"; label: "Output"; value: "Built-in";
                    focused: focused-row == 4;
                    activated => { root.setting-activated("audio.output"); }
                }

                SectionHeader { label: "CONNECTIVITY"; }
                SettingsRow {
                    icon: "📶"; label: "Wi-Fi"; value: wifi-value;
                    focused: focused-row == 5;
                    activated => { root.setting-activated("network.wifi"); }
                }
                SettingsRow {
                    icon: "🔵"; label: "Bluetooth"; value: bt-value;
                    focused: focused-row == 6;
                    activated => { root.setting-activated("network.bluetooth"); }
                }
                SettingsRow {
                    icon: "📡"; label: "Cellular"; value: cellular-value;
                    focused: focused-row == 7;
                    activated => { root.setting-activated("network.cellular"); }
                }

                SectionHeader { label: "SYSTEM"; }
                SettingsRow {
                    icon: "🛡"; label: "VPN"; value: vpn-value;
                    focused: focused-row == 8;
                    activated => { root.setting-activated("network.vpn"); }
                }
                SettingsRow {
                    icon: "🔋"; label: "Battery"; value: battery-value;
                    focused: focused-row == 9;
                    activated => { root.setting-activated("system.battery"); }
                }
                SettingsRow {
                    icon: "ℹ"; label: "About"; value: "v0.1.0";
                    focused: focused-row == 10;
                    activated => { root.setting-activated("system.about"); }
                }
            }
        }
    }
}
