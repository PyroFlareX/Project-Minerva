// =============================================================================
// app_settings.slint — Torchform Settings app
//
// Settings rows are modelled as a flat array (pushed from Rust) so ListView
// can render them with a single `for` loop. Row kind: "header" | "row".
// setting-activated(key) fires when the user confirms a row; the backend
// cycles the value and re-pushes the updated entries array.
// =============================================================================

import { Tokens } from "tokens.slint";
import { ListView } from "std-widgets.slint";

export struct SettingsEntry {
    kind:  string,   // "header" | "row"
    icon:  string,
    label: string,
    value: string,
    key:   string,   // used by setting-activated callback
}

export component AppSettings inherits Rectangle {
    in property <int>              focused-row: 0;
    in property <[SettingsEntry]>  entries;
    in property <string>           active-section: "";

    callback close-requested();
    callback setting-activated(string);

    background: Tokens.bg-base;

    VerticalLayout {
        padding: 0px;

        // Header bar
        Rectangle {
            height: 52px;
            background: Tokens.bg-surface;

            HorizontalLayout {
                padding-left:  Tokens.space-4;
                padding-right: Tokens.space-4;
                alignment: center;

                Text {
                    horizontal-stretch: 1;
                    text: active-section == "" ? "⚙  Settings" : ("⚙  Settings › " + active-section);
                    font-size: Tokens.text-xl;
                    font-family: Tokens.font-sans;
                    font-weight: Tokens.weight-semibold;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    width: 32px; height: 32px;
                    border-radius: 16px;
                    background: Tokens.bg-elevated;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "✕";
                        font-size: Tokens.text-sm;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.close-requested(); } }
                }
            }
        }

        // Scrollable list — one `for` loop required by ListView
        ListView {
            horizontal-stretch: 1;
            vertical-stretch:   1;

            for entry[idx] in entries: Rectangle {
                width: parent.width;
                height: entry.kind == "header" ? 28px : 52px;

                // Section header row
                if entry.kind == "header": Rectangle {
                    width: parent.width; height: parent.height;
                    background: transparent;
                    Text {
                        text: entry.label;
                        font-size: Tokens.text-xs;
                        font-family: Tokens.font-sans;
                        font-weight: Tokens.weight-semibold;
                        color: Tokens.text-secondary;
                        x: Tokens.space-4;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // Settings row
                if entry.kind == "row": Rectangle {
                    width: parent.width; height: parent.height;
                    border-radius: Tokens.radius-md;
                    background: (focused-row == idx) ? Tokens.bg-elevated : transparent;
                    border-width: (focused-row == idx) ? 1px : 0px;
                    border-color: Tokens.border-focused;
                    animate background { duration: Tokens.anim-fast; }

                    HorizontalLayout {
                        padding-left:  Tokens.space-4;
                        padding-right: Tokens.space-4;
                        spacing: Tokens.space-3;
                        alignment: center;

                        Text {
                            text: entry.icon;
                            font-size: Tokens.text-lg;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: entry.label;
                            font-size: Tokens.text-md;
                            font-family: Tokens.font-sans;
                            color: Tokens.text-primary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: entry.value;
                            font-size: Tokens.text-sm;
                            font-family: Tokens.font-mono;
                            color: Tokens.text-secondary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "›";
                            font-size: Tokens.text-lg;
                            color: Tokens.text-disabled;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => { root.setting-activated(entry.key); }
                    }
                }
            }
        }
    }
}
