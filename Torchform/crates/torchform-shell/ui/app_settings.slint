// =============================================================================
// app_settings.slint — Torchform Settings app (stub)
//
// A basic settings screen. Each section is a placeholder row that will grow
// into real functionality as the DE matures.
// =============================================================================

import { Tokens } from "tokens.slint";

component SettingsRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> value: "";
    in property <bool>   focused: false;

    callback activated();

    height: 52px;
    border-radius: Tokens.radius-md;
    background: focused ? Tokens.bg-elevated : transparent;
    border-width: focused ? 1px : 0px;
    border-color: Tokens.border-focused;

    animate background { duration: Tokens.anim-fast; }

    HorizontalLayout {
        padding-left:  Tokens.space-4;
        padding-right: Tokens.space-4;
        spacing: Tokens.space-3;
        alignment: center;

        Text {
            text: icon;
            font-size: Tokens.text-lg;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: label;
            font-size: Tokens.text-md;
            font-family: Tokens.font-sans;
            color: Tokens.text-primary;
            vertical-alignment: center;
        }
        Text {
            text: value;
            font-size: Tokens.text-sm;
            font-family: Tokens.font-mono;
            color: Tokens.text-secondary;
            vertical-alignment: center;
        }
        Text {
            text: "›";
            font-size: Tokens.text-lg;
            color: Tokens.text-disabled;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.activated(); } }
}

component SectionHeader inherits Text {
    in property <string> label;
    text: label;
    font-size: Tokens.text-xs;
    font-family: Tokens.font-sans;
    font-weight: Tokens.weight-semibold;
    color: Tokens.text-secondary;
    height: 28px;
    vertical-alignment: center;
}

export component AppSettings inherits Window {
    in property <int> focused-row: 0;
    callback close-requested();

    title: "Settings";
    width:  640px;
    height: 540px;
    background: Tokens.bg-base;

    VerticalLayout {
        padding: 0px;

        // Header
        Rectangle {
            height: 52px;
            background: Tokens.bg-surface;
            border-width: 0px;

            HorizontalLayout {
                padding-left:  Tokens.space-4;
                padding-right: Tokens.space-4;
                alignment: center;

                Text {
                    horizontal-stretch: 1;
                    text: "⚙  Settings";
                    font-size: Tokens.text-xl;
                    font-family: Tokens.font-sans;
                    font-weight: Tokens.weight-semibold;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 32px; height: 32px;
                    border-radius: 16px;
                    background: Tokens.bg-elevated;
                    Text {
                        width: parent.width; height: parent.height;
                        text: "✕";
                        font-size: Tokens.text-sm;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.close-requested(); } }
                }
            }
        }

        // Content
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: Tokens.bg-base;
            clip: true;

            VerticalLayout {
                padding: Tokens.space-4;
                spacing: Tokens.space-1;

                SectionHeader { label: "DISPLAY"; }
                SettingsRow { icon: "🔆"; label: "Brightness";   value: "80%";    focused: focused-row == 0; }
                SettingsRow { icon: "🌙"; label: "Night Mode";   value: "Off";    focused: focused-row == 1; }
                SettingsRow { icon: "📐"; label: "Resolution";   value: "1920×1080"; focused: focused-row == 2; }

                SectionHeader { label: "AUDIO"; }
                SettingsRow { icon: "🔊"; label: "Volume";       value: "65%";    focused: focused-row == 3; }
                SettingsRow { icon: "🎧"; label: "Output";       value: "Built-in"; focused: focused-row == 4; }

                SectionHeader { label: "CONNECTIVITY"; }
                SettingsRow { icon: "📶"; label: "Wi-Fi";        value: "Connected"; focused: focused-row == 5; }
                SettingsRow { icon: "🔵"; label: "Bluetooth";    value: "On";     focused: focused-row == 6; }
                SettingsRow { icon: "📡"; label: "Cellular";     value: "Off";    focused: focused-row == 7; }

                SectionHeader { label: "SYSTEM"; }
                SettingsRow { icon: "🛡";  label: "VPN";         value: "Off";    focused: focused-row == 8; }
                SettingsRow { icon: "🔋"; label: "Battery";      value: "87%";    focused: focused-row == 9; }
                SettingsRow { icon: "ℹ"; label: "About";        value: "v0.1.0"; focused: focused-row == 10; }
            }
        }
    }
}
