# =============================================================================
# Project Minerva — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Secrets / environment
# ---------------------------------------------------------------------------
.env
*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# Rust / Cargo
# ---------------------------------------------------------------------------
target/
Torchform/target/
# Keep Cargo.lock for binaries (remove the next line if you don't want it tracked)
# Cargo.lock

# rust-analyzer project file (generated by non-Cargo build systems)
rust-project.json

# ---------------------------------------------------------------------------
# KiCad (PCB / schematic files)
# ---------------------------------------------------------------------------
# Temporary / backup files
*.bak
*.bck
*-backups/
*.kicad_prl
*.sch-bak
*~
_autosave-*
*.tmp
fp-info-cache
rescue-backup/

# Netlist exports
*.net
*.dsn
*.ses

# BOM / tabular exports (generated — commit source, not output)
*.tsv
*.csv
bom/

# Gerber / fabrication output (generated)
out/
gerbers/
fab/

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.fuse_hidden*
.directory
.Trash-*

# VS Code
.vscode/settings.json
.vscode/launch.json
# Keep .vscode/extensions.json if you want to share recommended extensions
# .vscode/

# JetBrains / CLion
.idea/
*.iml

# Python bytecode (scripts/)
__pycache__/
*.pyc
*.pyo

# Logs
*.log
logs/
*.lock
Notes/scratchpad.txt
Minerva-Hardware/~CM5IO.kicad_pcb.lck
