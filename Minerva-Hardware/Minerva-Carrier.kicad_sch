	)
	(text "Battery completion: U30 TPS61088 SYS->5.1V/5A boost; U31 MAX17048 gauge (I2C 0x36, BQ bus); J24 pack B+/B- (2P); TS emulated at 25C by R76/R18/R77 - JEITA disabled. QON->PWR_BUT via D6 (ship >15s). docs/dock-usbc-architecture.md"
		(exclude_from_sim no)
		(at 13.97 204.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e41b155f-eeca-4135-bf82-dacca2050535")
	)
