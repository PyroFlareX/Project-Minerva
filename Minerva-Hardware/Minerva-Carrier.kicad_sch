	)
	(text "J23: single external USB-C (charge + USB2/nRPIBOOT + USB3 + DP alt mode).\nSS/SBU pairs go to CM5_HighSpeed mux via GLOBAL labels USBC_*.\nCC1/CC2 owned by TPS65987D (CM5_HighSpeed). R73/R74 0R re-attach CM5 CC pins\n(CM5_CC1/2) for bring-up WITHOUT the PD controller - DNP them once TPS is flashed.\nLayout: 90ohm diff pairs, TVS on VBUS/USB2/CC per CONTEXT 5.1; SS pairs len-matched."
		(exclude_from_sim no)
		(at 66.04 24.892 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "452dcaf0-89df-4abd-95ea-9d03232f03b7")
	)
